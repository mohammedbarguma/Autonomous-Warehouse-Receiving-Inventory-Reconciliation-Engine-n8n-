    {
      "parameters": {
        "jsCode": "// Validate one or many records and shape them to match the sheet headers.\nconst REQUIRED = {\n  PO:       ['po_number', 'supplier_id', 'internal_sku', 'ordered_qty', 'unit_price'],\n  DELIVERY: ['po_number', 'supplier_id', 'supplier_sku_raw', 'delivered_qty'],\n  SCAN:     ['po_number', 'scanned_sku_raw', 'good_qty'],\n  INVOICE:  ['po_number', 'supplier_id', 'supplier_sku_raw', 'invoiced_qty', 'unit_price'],\n};\nconst PREFIX = { PO: 'L', DELIVERY: 'D', SCAN: 'SC', INVOICE: 'INV' };\nconst NUMERIC = ['ordered_qty', 'delivered_qty', 'good_qty', 'damaged_qty', 'invoiced_qty', 'unit_price'];\n\nconst body = $input.first().json.body ?? $input.first().json;\nconst docType = String(body.doc_type ?? '').trim().toUpperCase();\nif (!REQUIRED[docType]) {\n  throw new Error(`Invalid doc_type \"${body.doc_type}\". Use PO, DELIVERY, SCAN or INVOICE.`);\n}\n\n// Accept a single record or {doc_type, rows: [...]}\nconst rows = Array.isArray(body.rows) ? body.rows : [body];\nconst today = new Date().toISOString().slice(0, 10);\nconst stamp = Date.now();\nconst out = [];\n\nrows.forEach((raw, i) => {\n  const rec = { ...raw };\n  delete rec.doc_type;\n  const missing = REQUIRED[docType].filter(f => rec[f] === undefined || rec[f] === null || rec[f] === '');\n  if (missing.length) {\n    throw new Error(`${docType} row ${i + 1} is missing: ${missing.join(', ')}`);\n  }\n  for (const f of NUMERIC) {\n    if (rec[f] !== undefined && rec[f] !== '') {\n      const n = Number(rec[f]);\n      if (Number.isNaN(n) || n < 0) throw new Error(`${docType} row ${i + 1}: ${f} must be a non-negative number`);\n      rec[f] = n;\n    }\n  }\n  rec.po_number = String(rec.po_number).trim().toUpperCase();\n\n  // Defaults per document type\n  const id = `${PREFIX[docType]}-${stamp}-${i + 1}`;\n  if (docType === 'PO') {\n    rec.line_id = rec.line_id || id;\n    rec.created_at = rec.created_at || today;\n  } else if (docType === 'DELIVERY') {\n    rec.delivery_id = rec.delivery_id || id;\n    rec.delivery_date = rec.delivery_date || today;\n  } else if (docType === 'SCAN') {\n    rec.scan_id = rec.scan_id || id;\n    rec.damaged_qty = rec.damaged_qty ?? 0;\n    rec.scan_date = rec.scan_date || today;\n    rec.scanned_by = rec.scanned_by || 'unknown';\n  } else if (docType === 'INVOICE') {\n    rec.invoice_id = rec.invoice_id || id;\n    rec.invoice_date = rec.invoice_date || today;\n  }\n  rec.status = 'pending';\n  out.push({ json: { doc_type: docType, ...rec } });\n});\n\nreturn out;\n"
      },
