    {
      "parameters": {
        "jsCode": "// Keep only the Audit_Log columns so no helper fields leak into the sheet\nconst keep = ['log_id','timestamp','po_number','internal_sku','event','actor','old_value','new_value','details'];\nreturn $input.all().map(i => ({ json: Object.fromEntries(keep.map(k => [k, i.json[k] ?? ''])) }));\n"
      },
