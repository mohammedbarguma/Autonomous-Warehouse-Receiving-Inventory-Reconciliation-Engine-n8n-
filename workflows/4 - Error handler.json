    {
      "parameters": {
        "jsCode": "// Normalise the Error Trigger payload into one record for the alert and the log.\n// Execution errors carry `execution`; errors in a trigger node carry `trigger` instead.\nconst e = $input.first().json;\nconst exec = e.execution ?? {};\nconst trig = e.trigger ?? {};\nconst err  = exec.error ?? trig.error ?? {};\nconst ts   = new Date().toISOString();\n\nconst workflowName = e.workflow?.name ?? 'unknown workflow';\nconst failedNode   = exec.lastNodeExecuted ?? err.node?.name ?? trig.error?.node?.name ?? 'unknown node';\nconst message      = String(err.message ?? 'No error message supplied').slice(0, 500);\n\n// Did the node exhaust its retries, or is this already a manual retry of a failed run?\nconst isRetryOfEarlier = Boolean(exec.retryOf);\n\nreturn [{ json: {\n  log_id: `LOG-${Date.now()}-ERR`,\n  timestamp: ts,\n  po_number: '',\n  internal_sku: '',\n  event: 'WORKFLOW_ERROR',\n  actor: 'n8n:error-handler',\n  old_value: workflowName,\n  new_value: failedNode,\n  details: JSON.stringify({\n    workflow_id: e.workflow?.id ?? '',\n    execution_id: exec.id ?? '',\n    execution_url: exec.url ?? '',\n    mode: exec.mode ?? trig.mode ?? '',\n    retry_of: exec.retryOf ?? '',\n    message,\n  }),\n  // fields used only by the email, not written to the sheet\n  _workflow: workflowName,\n  _node: failedNode,\n  _message: message,\n  _url: exec.url ?? '(trigger failed before an execution was created)',\n  _repeat: isRetryOfEarlier,\n} }];\n"
      },
      "name": "Shape error record",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -288,
        128
      ],
      "id": "65c9e34a-87d5-443a-984d-4ec4491fc04c"
    },
    {
      "parameters": {
        "sendTo": "mbargumajajere126@gmail.com",
        "subject": "={{ $json._repeat ? '[REPEAT] ' : '' }}Warehouse automation failed: {{ $json._workflow }}",
        "emailType": "text",
        "message": "=Workflow: {{ $json._workflow }}\nFailed node: {{ $json._node }}\nTime (UTC): {{ $json.timestamp }}\n\nError:\n{{ $json._message }}\n\nOpen the execution to inspect and retry:\n{{ $json._url }}\n\nThe node has already been retried automatically before this alert was sent. Records involved remain in 'pending' status and will be picked up again on the next scheduled run once the cause is fixed.",
        "options": {}
      },
