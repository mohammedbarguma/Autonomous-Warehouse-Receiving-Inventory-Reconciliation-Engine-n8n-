    {
      "parameters": {
        "jsCode": "// Four-way reconciliation: Ordered -> Delivered -> Scanned -> Invoiced\nconst clean = s => String(s ?? '').toUpperCase().replace(/[^A-Z0-9]/g, '');\nconst norm  = s => String(s ?? '').trim().toUpperCase();\nconst num   = v => { const n = Number(v); return Number.isFinite(n) ? n : 0; };\nconst rows  = name => $(name).all().map(i => i.json).filter(r => r && Object.keys(r).length);\nconst isPending = r => String(r.status ?? '').trim().toLowerCase() === 'pending';\n\nconst pos        = rows('Read Purchase_Orders').filter(r => r.po_number && isPending(r));\nconst deliveries = rows('Read Deliveries').filter(r => r.po_number && isPending(r));\nconst scans      = rows('Read Warehouse_Scans').filter(r => r.po_number && isPending(r));\nconst invoices   = rows('Read Invoices').filter(r => r.po_number && isPending(r));\n\n// SKU_Map: supplier + cleaned supplier code -> internal SKU\nconst skuMap = {};\nrows('Read SKU_Map').forEach(r => {\n  skuMap[`${norm(r.supplier_id)}|${clean(r.supplier_sku_clean)}`] = String(r.internal_sku).trim();\n});\n\n// Running inventory so several matched lines for one SKU accumulate correctly\nconst inventory = {};\nrows('Read Inventory').forEach(r => { inventory[String(r.internal_sku).trim()] = num(r.on_hand); });\n\nconst out = [];\nfor (const po of pos) {\n  const poNum = norm(po.po_number);\n  const sup   = norm(po.supplier_id);\n  const sku   = String(po.internal_sku).trim();\n  const price = num(po.unit_price);\n  const ordered = num(po.ordered_qty);\n\n  const mine = list => list.filter(r => norm(r.po_number) === poNum);\n  const d = mine(deliveries), s = mine(scans), v = mine(invoices);\n  if (!d.length || !s.length || !v.length) continue;   // incomplete: stays pending\n\n  const poSkus = new Set(pos.filter(p => norm(p.po_number) === poNum).map(p => String(p.internal_sku).trim()));\n  const unmapped = new Set(), mismatched = new Set();\n  const resolve = raw => {\n    const m = skuMap[`${sup}|${clean(raw)}`];\n    if (!m) unmapped.add(raw);\n    else if (!poSkus.has(m)) mismatched.add(raw);\n    return m;\n  };\n\n  let delivered = 0, good = 0, damaged = 0, invoiced = 0;\n  d.forEach(r => { if (resolve(r.supplier_sku_raw) === sku) delivered += num(r.delivered_qty); });\n  s.forEach(r => { if (resolve(r.scanned_sku_raw) === sku) { good += num(r.good_qty); damaged += num(r.damaged_qty); } });\n  v.forEach(r => { if (resolve(r.supplier_sku_raw) === sku) invoiced += num(r.invoiced_qty); });\n\n  let categories = [];\n  if (unmapped.size) categories = ['unmapped_sku'];\n  else if (mismatched.size) categories = ['sku_mismatch'];\n  else {\n    if (delivered < ordered) categories.push('under_shipment');\n    if (delivered > ordered) categories.push('over_shipment');\n    if (good + damaged < delivered) categories.push('receiving_shortage');\n    if (good + damaged > delivered) categories.push('receiving_overage');\n    if (damaged > 0) categories.push('damage');\n    if (invoiced > good) categories.push('over_billing');\n  }\n\n  let claim = 0;\n  if (!unmapped.size && !mismatched.size) {\n    if (invoiced > good) claim = (invoiced - good) * price;\n    else if (categories.includes('under_shipment')) claim = (ordered - good) * price;\n  }\n\n  const result = categories.length ? 'discrepancy' : 'matched';\n  const before = inventory[sku] ?? 0;\n  let after = before;\n  if (result === 'matched') { after = before + good; inventory[sku] = after; }\n\n  out.push({ json: {\n    result, po_number: poNum, line_id: po.line_id, internal_sku: sku, supplier_id: sup,\n    unit_price: price, ordered_qty: ordered, delivered_qty: delivered,\n    scanned_good_qty: good, scanned_damaged_qty: damaged, invoiced_qty: invoiced,\n    categories, claim_amount: claim,\n    unmapped_codes: [...unmapped], mismatched_codes: [...mismatched],\n    delivery_ids: d.map(r => r.delivery_id), scan_ids: s.map(r => r.scan_id), invoice_ids: v.map(r => r.invoice_id),\n    on_hand_before: before, on_hand_after: after,\n  } });\n}\nreturn out;\n"
      },
