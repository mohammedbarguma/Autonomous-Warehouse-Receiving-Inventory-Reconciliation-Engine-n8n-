    {
      "parameters": {
        "jsCode": "// Turn each reconciliation result into sheet write-backs (status updates, inventory, audit log)\nconst items = $input.all().map(i => i.json);\nconst ts = new Date().toISOString();\nconst today = ts.slice(0, 10);\nconst out = [];\nlet n = 0;\nconst add = o => out.push({ json: o });\n\nfor (const r of items) {\n  const matched = r.result === 'matched';\n  const status = matched ? 'processed' : 'discrepancy';\n\n  add({ target: 'PO', line_id: r.line_id, status });\n  (r.delivery_ids || []).forEach(id => add({ target: 'DELIVERY', delivery_id: id, status }));\n  (r.scan_ids || []).forEach(id => add({ target: 'SCAN', scan_id: id, status }));\n  (r.invoice_ids || []).forEach(id => add({ target: 'INVOICE', invoice_id: id, status }));\n\n  if (matched) {\n    add({ target: 'INVENTORY', internal_sku: r.internal_sku, on_hand: r.on_hand_after, last_updated: today });\n  }\n\n  add({\n    target: 'AUDIT',\n    log_id: `LOG-${Date.now()}-${++n}`,\n    timestamp: ts,\n    po_number: r.po_number,\n    internal_sku: r.internal_sku,\n    event: matched ? 'MATCHED_INVENTORY_UPDATED' : 'DISCREPANCY_FOUND',\n    actor: 'n8n:reconcile',\n    old_value: matched ? String(r.on_hand_before) : 'pending',\n    new_value: matched ? String(r.on_hand_after) : 'discrepancy',\n    details: JSON.stringify({\n      ordered: r.ordered_qty, delivered: r.delivered_qty,\n      scanned_good: r.scanned_good_qty, scanned_damaged: r.scanned_damaged_qty,\n      invoiced: r.invoiced_qty, categories: r.categories, claim_amount: r.claim_amount,\n    }),\n  });\n}\nreturn out;\n"
      },
